cmake_minimum_required(VERSION 3.25)
if(NOT MAIN_EXE OR NOT EXISTS "${MAIN_EXE}")
    message(FATAL_ERROR "Set MAIN_EXE to the built shgrep.exe")
endif()
if(NOT COMPILER_DLL OR NOT EXISTS "${COMPILER_DLL}")
    message(FATAL_ERROR "Set COMPILER_DLL to the built shgrep-compiler.dll")
endif()
if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "Release" AND NOT CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Portable packaging requires a Release build")
endif()
if(NOT @SHGREP_PORTABLE_HAS_PCRE2@)
    message(FATAL_ERROR "Portable packaging requires PCRE2")
endif()
set(name "shgrep-windows-x64-@SHGREP_HS_ARCH@")
set(output "@CMAKE_CURRENT_BINARY_DIR@/packages")
file(MAKE_DIRECTORY "${output}")
string(TIMESTAMP stamp "%Y%m%d%H%M%S" UTC)
set(scratch "${output}/.stage-${name}-${stamp}")
if(EXISTS "${scratch}")
    message(FATAL_ERROR "Package staging path already exists: ${scratch}")
endif()
set(stage "${scratch}/${name}")
file(MAKE_DIRECTORY "${stage}")
configure_file("${MAIN_EXE}" "${stage}/shgrep.exe" COPYONLY)
configure_file("${COMPILER_DLL}" "${stage}/shgrep-compiler.dll" COPYONLY)
set(DESTINATION "${stage}")
set(PACKER "${MAIN_EXE}")
include("@CMAKE_CURRENT_BINARY_DIR@/generated/stage_repl_runtime.cmake")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${scratch}/package.zip" --format=zip --
    "${name}/shgrep.exe" "${name}/shgrep-compiler.dll" "${name}/shgrep.dat"
    "${name}/README.txt" "${name}/tools" "${name}/licenses"
    WORKING_DIRECTORY "${scratch}" RESULT_VARIABLE archived)
if(NOT archived EQUAL 0)
    message(FATAL_ERROR "ZIP creation failed (${archived}); staging remains at ${scratch}")
endif()
file(SHA256 "${scratch}/package.zip" zip_hash)
file(RENAME "${scratch}/package.zip" "${output}/${name}.zip")
file(WRITE "${output}/${name}.zip.sha256" "${zip_hash}  ${name}.zip\n")
cmake_path(IS_PREFIX output "${scratch}" NORMALIZE inside_output)
if(inside_output AND NOT scratch STREQUAL output)
    file(REMOVE_RECURSE "${scratch}")
endif()
message(STATUS "Portable package: ${output}/${name}.zip")
