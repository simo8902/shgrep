cmake_minimum_required(VERSION 3.20)
function(deploy_file source targets_file)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "Deployment source is missing: ${source}")
    endif()
    if(NOT EXISTS "${targets_file}")
        message(FATAL_ERROR "Deployment target list is missing: ${targets_file}")
    endif()
    file(STRINGS "${targets_file}" targets ENCODING UTF-8)
    foreach(target IN LISTS targets)
        if(target STREQUAL "")
            continue()
        endif()
        get_filename_component(directory "${target}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${source}" "${target}"
            RESULT_VARIABLE result ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot deploy ${source} to ${target}: ${error}")
        endif()
    endforeach()
endfunction()

deploy_file("${SOURCE}" "${TARGETS_FILE}")
deploy_file("${DATA_SOURCE}" "${DATA_TARGETS_FILE}")
deploy_file("${COMPILER_SOURCE}" "${COMPILER_TARGETS_FILE}")
