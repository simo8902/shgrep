cmake_minimum_required(VERSION 3.20)
if(NOT SOURCE OR NOT TARGETS_FILE)
    message(FATAL_ERROR "deploy.cmake needs -DSOURCE=<exe> and -DTARGETS_FILE=<file with one path per line>")
endif()
file(STRINGS "${TARGETS_FILE}" targets)
file(SHA256 "${SOURCE}" source_hash)
foreach(target IN LISTS targets)
    if(target STREQUAL "")
        continue()
    endif()
    get_filename_component(folder "${target}" DIRECTORY)
    get_filename_component(name "${target}" NAME)
    file(MAKE_DIRECTORY "${folder}")
    file(GLOB stale "${folder}/${name}.*.old")
    foreach(old IN LISTS stale)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -f "${old}" RESULT_VARIABLE ignored ERROR_QUIET)
    endforeach()
    if(EXISTS "${target}")
        file(SHA256 "${target}" target_hash)
        if(target_hash STREQUAL source_hash)
            message(STATUS "shgrep up to date at ${target}")
            continue()
        endif()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${SOURCE}" "${target}" RESULT_VARIABLE copied ERROR_QUIET)
    if(NOT copied EQUAL 0)
        string(TIMESTAMP stamp "%Y%m%d%H%M%S")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${target}" "${target}.${stamp}.old" RESULT_VARIABLE renamed ERROR_QUIET)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${SOURCE}" "${target}" RESULT_VARIABLE copied ERROR_VARIABLE why)
    endif()
    if(copied EQUAL 0)
        message(STATUS "shgrep deployed to ${target}")
    else()
        message(WARNING "shgrep was NOT deployed to ${target}: ${why}")
    endif()
endforeach()
