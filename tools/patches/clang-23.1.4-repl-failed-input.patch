+  /// DeferredVTables and EmittedVTables when this module started; restored by
+  /// discardModuleEmissions().
+  std::vector<const CXXRecordDecl *> DeferredVTablesAtModuleStart;
+  llvm::SmallPtrSet<const CXXRecordDecl *, 8> EmittedVTablesAtModuleStart;
+
   /// A queue of (optional) vtables that may be emitted opportunistically.
   std::vector<const CXXRecordDecl *> OpportunisticVTables;
 
@@ -1855,6 +1860,12 @@
   /// because we'll lose all important information after each repl.
   void moveLazyEmissionStates(CodeGenModule *NewBuilder);
 
+  /// Incremental compilation: forget what was emitted into the current module,
+  /// which is being discarded. Declarations queued or emitted only there become
+  /// deferred again, and the vtable queues return to their state at the start
+  /// of the module.
+  void discardModuleEmissions();
+
   /// Emit the IR encoding to attach the CUDA launch bounds attribute to \p F.
