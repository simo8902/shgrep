diff -ru a/clang/lib/CodeGen/ModuleBuilder.cpp b/clang/lib/CodeGen/ModuleBuilder.cpp
--- a/clang/lib/CodeGen/ModuleBuilder.cpp
+++ b/clang/lib/CodeGen/ModuleBuilder.cpp
@@ -155,6 +155,17 @@
       return M.get();
     }
 
+    llvm::Module *DiscardModule(llvm::StringRef NewModuleName) {
+      assert(M && "No module to discard");
+      assert(!HandlingTopLevelDecls && "Discarding while handling a decl");
+      // Inline member functions still waiting belong to the discarded input.
+      DeferredInlineMemberFuncDefs.clear();
+      Builder->discardModuleEmissions();
+      // StartModule destroys the old builder; keep its module alive until then.
+      std::unique_ptr<llvm::Module> Discarded = std::move(M);
+      return StartModule(NewModuleName, Discarded->getContext());
+    }
+
     void Initialize(ASTContext &Context) override {
       Ctx = &Context;
 
@@ -394,6 +405,10 @@
   return static_cast<CodeGeneratorImpl*>(this)->StartModule(ModuleName, C);
 }
 
+llvm::Module *CodeGenerator::DiscardModule(llvm::StringRef NewModuleName) {
+  return static_cast<CodeGeneratorImpl *>(this)->DiscardModule(NewModuleName);
+}
