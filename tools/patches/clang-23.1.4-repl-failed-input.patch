+  DiagnosticsEngine &Diags = S.getDiagnostics();
+
+  // Withdraw a failed input so that later inputs see the state before it.
+  auto DiscardInput = [&] {
+    // CodeGen ignores new decls while an unrecoverable error is pending, so
+    // clear the error first: the instantiations below must reach CodeGen to be
+    // emitted later.
+    Diags.Reset(/*soft=*/true);
+    Diags.getClient()->clear();
+
+    // Finish the implicit instantiations this input requested. Sema has already
+    // recorded their points of instantiation, so a later input that uses the
+    // same specializations would not queue them again and their definitions
+    // would stay missing; the scopes above would discard what is still pending.
+    LocalInstantiations.perform();
+    GlobalInstantiations.perform();
+
+    // Drop the partial module: its definitions from this input would collide
+    // with those of a later input, and its initializers must not run. CodeGen
+    // makes the inline and template code it emitted there pending again.
+    if (CodeGenerator *CG = Act ? Act->getCodeGen() : nullptr) {
+      if (CG->GetModule()) {
+        static unsigned DiscardedID = 0;
+        CG->DiscardModule("incr_module_discarded_" +
+                          std::to_string(DiscardedID++));
+      }
+    }
+
+    CleanUpPTU(C.getTranslationUnitDecl());
+
+    Diags.Reset(/*soft=*/true);
+    Diags.getClient()->clear();
+  };
+
